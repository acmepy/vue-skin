{
  "name": "vue-skin",
  "version": "0.0.2",
  "description": "Una capa de abstracción de UI para Vue 3.",
  "license": "MIT",
  "author": "",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vue-skin/playground",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
